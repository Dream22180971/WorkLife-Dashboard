{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "摸鱼助手 WorkLife Dashboard",
  "version": "0.1.0",
  "identifier": "com.worklife.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "摸鱼助手 · WorkLife Dashboard",
        "width": 1080,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600
      },
      {
        "label": "widget",
        "title": "摸鱼助手 Widget",
        "url": "index.html?widget=1",
        "width": 260,
        "height": 176,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
